<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_care_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_btn_dark_bg"
            android:gravity="center"
            android:text="💉"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_care_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rabies Annual Booster"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_care_pet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient: Max - Greenwood Clinic"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:layout_marginTop="2dp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_care_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Due in 4 days (Aug 28)"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_open_passport"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Passport"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
