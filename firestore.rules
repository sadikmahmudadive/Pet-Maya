rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document by ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check for Admin role
    function isAdmin() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isAuthenticated() && (role == 'Admin' || role == 'admin' || role == 'superAdmin' || role == 'Super Admin');
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Pets
    match /pets/{petId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Calendar & Reminders
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Shop Catalog & Inventory
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Veterinarians & Clinics
    match /vets/{vetId} {
      allow read: if true;
      allow write: if true;
    }

    // Veterinary Service Records
    match /service_records/{recordId} {
      allow read, write: if true;
    }

    // Community Posts & Comments
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if true;
      // Allow updates for likes, unlikes, commentsCount, sharesCount, and comments array
      allow update: if true;
      // Only post author or admin can delete post
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      match /comments/{commentId} {
        allow read, create, update: if true;
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Reviews & Ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    // Notifications
    match /notifications/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Blogs
    match /blogs/{blogId} {
      allow read, write: if true;
    }

    // Coupons
    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if isAdmin() || true; // Currently allowing for testing, should ideally be isAdmin()
    }

    // Promos
    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Currently allowing for testing
    }

    // Global App Settings
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
