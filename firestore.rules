rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Pet Maya — Firestore security rules
//
// Principles
//  • Deny by default: anything not matched below is closed.
//  • Object-level access: every private document is tied to its owner
//    (users/{uid}, pets.ownerID, orders.userId, events.userId/providerId,
//    service_records.ownerId/providerId, devices.ownerId).
//  • Server-controlled fields (role privileges, verification, suspension,
//    referral credit, staff access, device ownership) can't be set by clients.
//  • Cross-user side effects (referral points, public profiles, record owner
//    stamping, order price checks) run in Cloud Functions with the Admin SDK,
//    which bypasses these rules.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ───────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return hasProfile() ? me().get('role', '') : '';
    }
    function notSuspended() {
      return !hasProfile() || me().get('isSuspended', false) != true;
    }
    function isPrivilegedRole(r) {
      return r is string && r.lower().matches('(super ?)?admin');
    }
    function isAdmin() {
      return signedIn() && isPrivilegedRole(myRole());
    }
    // Vets, groomers, boarding and shelters. Access to other people's pets and
    // medical records needs an admin-verified, non-suspended provider account.
    function isProviderRole(r) {
      return r is string && r.lower().matches('(veterinarian|vet|grooming|groomer|boarding|shelter.*)');
    }
    function isVerifiedProvider() {
      return signedIn() && isProviderRole(myRole())
        && me().get('isVerified', false) == true
        && me().get('isSuspended', false) != true;
    }
    function isShopRole(r) {
      return r is string && r.lower().matches('(pet ?shop|petshop)');
    }
    function isVerifiedShop() {
      return signedIn() && isShopRole(myRole())
        && me().get('isVerified', false) == true
        && me().get('isSuspended', false) != true;
    }

    // ── ERP / POS staff (users/{uid}.staffRole; the app never writes it) ──
    function myStaffRole() {
      return hasProfile() ? me().get('staffRole', '') : '';
    }
    function hasStaffRole(roles) {
      return signedIn() && (isAdmin() || myStaffRole() in roles);
    }
    function isStaff() {
      return hasStaffRole(['Manager', 'Cashier', 'Pharmacist', 'Accountant', 'Storekeeper']);
    }
    function canManageCatalog() {
      return hasStaffRole(['Manager', 'Storekeeper', 'Pharmacist']) || isVerifiedShop();
    }
    function canSeeAllOrders() {
      return isStaff() || isVerifiedShop();
    }

    // ── Write-shape helpers ────────────────────────────────────────────────
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function unchanged(field) {
      return !(field in changed());
    }
    function shortString(v, max) {
      return v is string && v.size() <= max;
    }
    function optShortString(field, max) {
      return !(field in request.resource.data) || request.resource.data[field] == null
        || shortString(request.resource.data[field], max);
    }
    // In-app links may only point inside the app/site (blocks javascript:,
    // data: and off-site phishing URLs in notifications).
    function isSafeLink(v) {
      return v == null || v == '' || (v is string && v.size() <= 300 && v.matches('/[^/\\\\].*|/'));
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // Private: email, phone, address, push tokens. Other people's names and
    // photos come from public_profiles (kept in sync by a Cloud Function).
    function serverControlledUserFields() {
      return ['isVerified', 'isSuspended', 'staffRole', 'referredBy', 'accountStatus'];
    }
    function validNewUser(uid) {
      let d = request.resource.data;
      return !isPrivilegedRole(d.get('role', ''))
        && d.get('staffRole', '') == ''
        && d.get('isVerified', false) == false
        && d.get('isSuspended', false) == false
        && d.get('referredBy', null) == null
        && d.get('points', 0) is number && d.get('points', 0) <= 25
        && d.get('uid', uid) == uid;
    }
    function pointsDelta() {
      return request.resource.data.get('points', 0) - resource.data.get('points', 0);
    }
    function validSelfUpdate() {
      return !changed().hasAny(serverControlledUserFields())
        // Role: a non-privileged role, and only while the account is unverified
        // (a verified provider can't move their verification to another role).
        && (unchanged('role')
            || (!isPrivilegedRole(request.resource.data.get('role', ''))
                && resource.data.get('isVerified', false) == false))
        // Loyalty points can only go up, in bounded steps (order/activity rewards).
        && (unchanged('points') || (pointsDelta() > 0 && pointsDelta() <= 500))
        && request.resource.data.get('uid', request.auth.uid) == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin() || isStaff();
      allow list: if isAdmin() || isStaff();
      allow create: if (isSelf(userId) && validNewUser(userId)) || isAdmin();
      allow update: if (isSelf(userId) && validSelfUpdate())
        || isAdmin()
        // Managers may grant console access, but never Manager or Admin.
        || (hasStaffRole(['Manager'])
            && changed().hasOnly(['staffRole', 'updatedAt'])
            && request.resource.data.get('staffRole', '') in ['', 'Cashier', 'Pharmacist', 'Accountant', 'Storekeeper']
            && !isPrivilegedRole(resource.data.get('role', '')));
      allow delete: if isSelf(userId) || isAdmin();
    }

    // Public author card (name, photo, role label). Written only by functions.
    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Pets ───────────────────────────────────────────────────────────────
    function isPetOwner(petId) {
      return signedIn()
        && exists(/databases/$(database)/documents/pets/$(petId))
        && get(/databases/$(database)/documents/pets/$(petId)).data.get('ownerID', '') == request.auth.uid;
    }
    match /pets/{petId} {
      allow read: if (signedIn() && resource.data.ownerID == request.auth.uid)
        || isAdmin() || isVerifiedProvider() || isStaff();
      allow create: if signedIn() && notSuspended()
        && request.resource.data.ownerID == request.auth.uid;
      allow update: if (signedIn() && resource.data.ownerID == request.auth.uid
                        && request.resource.data.ownerID == request.auth.uid)
        // Providers update clinical fields (weight, vaccines) but can't re-home a pet.
        || (isVerifiedProvider() && unchanged('ownerID'))
        || isAdmin();
      allow delete: if (signedIn() && resource.data.ownerID == request.auth.uid) || isAdmin();
    }

    // ── Calendar events & appointments ────────────────────────────────────
    function eventParty() {
      return signedIn() && (resource.data.get('userId', '') == request.auth.uid
        || resource.data.get('providerId', '') == request.auth.uid);
    }
    match /events/{eventId} {
      allow read: if eventParty() || isAdmin() || isStaff();
      allow create: if signedIn() && notSuspended() && (
          request.resource.data.get('userId', '') == request.auth.uid
          || (isVerifiedProvider() && request.resource.data.get('providerId', '') == request.auth.uid));
      allow update: if (eventParty()
                        && unchanged('userId') && unchanged('providerId'))
        || isAdmin() || isStaff();
      allow delete: if eventParty() || isAdmin();
    }

    // ── Shop catalogue ─────────────────────────────────────────────────────
    function validRatingBump() {
      return changed().hasOnly(['rating', 'ratingCount', 'updatedAt'])
        && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 5;
    }
    function validCheckoutStockMove() {
      let sold = request.resource.data.get('unitsSold', 0) - resource.data.get('unitsSold', 0);
      let stock = resource.data.get('stockCount', 0) - request.resource.data.get('stockCount', 0);
      return changed().hasOnly(['stockCount', 'unitsSold', 'updatedAt'])
        && sold == stock && sold > 0 && sold <= 50;
    }
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin() || canManageCatalog();
      allow update: if isAdmin() || canManageCatalog()
        // Shoppers: bounded side effects of checkout and reviews only.
        || (signedIn() && notSuspended() && (validCheckoutStockMove() || validRatingBump()));
    }

    // Product category tree: a flat collection, parentId points at the parent (empty = main category).
    // Anyone can read it (the shop menu is built from it); only admins and managers shape it.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if hasStaffRole(['Manager'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.get('parentId', '') is string;
      allow delete: if hasStaffRole(['Manager']);
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    function orderServerFields() {
      return ['stockDeducted', 'priceCheck', 'verifiedTotal', 'paidAt', 'refundedAt'];
    }
    // Guests have no direct write access: their orders go through the create_order Cloud Function, which prices,
    // checks stock and validates coupons on the server. Signed-in direct writes (the mobile app) may only start
    // an order in an opening state; fulfilment states are set by staff.
    function openingOrderStatus() {
      return request.resource.data.get('status', 'Pending') in ['Pending', 'Processing', 'Rx review', 'Packing', 'pending', 'processing'];
    }
    // A customer can cancel only until the order ships.
    function cancellableOrder() {
      return resource.data.get('status', '') in ['Pending', 'Processing', 'Rx review', 'Packing', 'pending', 'processing'];
    }
    match /orders/{orderId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid)
        || isAdmin() || canSeeAllOrders();
      allow create: if signedIn() && notSuspended() && request.resource.data.userId == request.auth.uid
        && openingOrderStatus()
        && !request.resource.data.keys().hasAny(orderServerFields())
        && request.resource.data.get('total', 0) is number
        && request.resource.data.get('total', 0) >= 0;
      // Customers may cancel an order that has not shipped, or request a return on a delivered one.
      allow update: if isAdmin() || canSeeAllOrders()
        || (signedIn() && resource.data.userId == request.auth.uid
            && ((cancellableOrder()
                 && changed().hasOnly(['status', 'cancelReason', 'cancelledAt', 'updatedAt'])
                 && request.resource.data.status in ['Cancelled', 'cancelled', 'Canceled'])
                || (resource.data.get('status', '') == 'Delivered'
                    && changed().hasOnly(['status', 'returnRequest', 'updatedAt'])
                    && request.resource.data.status == 'Return')));
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ── Vets & service providers (public directory) ───────────────────────
    match /vets/{vetId} {
      allow read: if true;
      allow create: if isAdmin() || (isSelf(vetId) && notSuspended()
        && request.resource.data.get('isVerified', false) == false);
      allow update: if isAdmin() || (isSelf(vetId) && notSuspended()
        && unchanged('isVerified') && unchanged('rating')
        && unchanged('reviewCount') && unchanged('reviewsCount'));
      allow delete: if isAdmin() || isSelf(vetId);
    }

    // ── Medical / service records ─────────────────────────────────────────
    // ownerId = the pet owner (stamped by the client and enforced/back-filled
    // by the stamp_record_owner function); providerId = who wrote the record.
    function recordParty() {
      return signedIn() && (resource.data.get('ownerId', '') == request.auth.uid
        || resource.data.get('providerId', '') == request.auth.uid);
    }
    match /service_records/{recordId} {
      allow read: if recordParty() || isAdmin() || isVerifiedProvider();
      allow create: if signedIn() && notSuspended()
        && request.resource.data.providerId == request.auth.uid
        && (isVerifiedProvider() || isPetOwner(request.resource.data.petId))
        && (!('ownerId' in request.resource.data)
            || !exists(/databases/$(database)/documents/pets/$(request.resource.data.petId))
            || request.resource.data.ownerId
                 == get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.get('ownerID', ''));
      allow update: if isAdmin()
        || (signedIn() && resource.data.get('providerId', '') == request.auth.uid
            && unchanged('providerId') && unchanged('ownerId') && unchanged('petId'))
        // The owner decides whether a record is shared with other vets.
        || (signedIn() && resource.data.get('ownerId', '') == request.auth.uid
            && changed().hasOnly(['isSharedWithVets']));
      allow delete: if isAdmin() || recordParty();
    }

    // ── Community feed ─────────────────────────────────────────────────────
    function onlyMyEntry(field) {
      return !(field in changed())
        || request.resource.data.get(field, {}).diff(resource.data.get(field, {}))
             .affectedKeys().hasOnly([request.auth.uid]);
    }
    function onlyMeInList(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return !(field in changed())
        || (after.difference(before).union(before.difference(after))).hasOnly([request.auth.uid]);
    }
    function counterStep(field) {
      return !(field in changed())
        || (request.resource.data.get(field, 0) - resource.data.get(field, 0) >= -1
            && request.resource.data.get(field, 0) - resource.data.get(field, 0) <= 1);
    }
    function validReaction() {
      return changed().hasOnly(['likesCount', 'likes', 'likedByUserIds', 'likedBy', 'userReactions',
                                'userReactions.' + request.auth.uid, 'sharesCount', 'commentsCount', 'comments'])
        && onlyMyEntry('likedBy') && onlyMyEntry('userReactions') && onlyMeInList('likedByUserIds')
        && counterStep('likesCount') && counterStep('likes') && counterStep('sharesCount') && counterStep('commentsCount')
        // Embedded comment previews may only grow, by one of my own comments.
        && (!('comments' in changed())
            || (request.resource.data.comments.size() == resource.data.get('comments', []).size() + 1
                && request.resource.data.comments.toSet().difference(resource.data.get('comments', []).toSet()).size() == 1
                && request.resource.data.comments[request.resource.data.comments.size() - 1].get('userId', '') == request.auth.uid));
    }
    match /community_posts/{postId} {
      allow read: if true;
      // Direct client creates blocked: all posts must go through submit_post Cloud Function
      allow create: if false;
      allow update: if isAdmin()
        // Author may mark amber alert as resolved
        || (signedIn() && resource.data.userId == request.auth.uid
            && changed().hasOnly(['isResolved', 'updatedAt']))
        // Readers may like/react within strict validated limits
        || (signedIn() && notSuspended() && validReaction());
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        // Direct client creates blocked: all comments must go through submit_comment Cloud Function
        allow create: if false;
        allow update: if isAdmin()
          || (signedIn() && notSuspended()
              && changed().hasOnly(['likesCount', 'likes', 'likedBy', 'likedByUserIds', 'userReactions'])
              && onlyMyEntry('likedBy') && onlyMyEntry('userReactions') && onlyMeInList('likedByUserIds'));
        allow delete: if isAdmin()
          || (signedIn() && resource.data.userId == request.auth.uid)
          || (signedIn() && get(/databases/$(database)/documents/community_posts/$(postId)).data.get('userId', '') == request.auth.uid);
      }
    }

    // ── Community Moderation Collections ────────────────────────────────────
    match /community_pending/{id} {
      allow read: if isAdmin() || hasStaffRole(['Manager']) || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // Server Cloud Functions only
    }
    match /community_reports/{id} {
      allow read: if isAdmin() || hasStaffRole(['Manager']);
      allow update: if isAdmin() || hasStaffRole(['Manager']); // For dismissing reports
      allow create, delete: if false;
    }
    match /moderation_strikes/{id} {
      allow read: if isAdmin() || hasStaffRole(['Manager']) || isSelf(id);
      allow update: if isAdmin() || hasStaffRole(['Manager']); // For admins lifting strikes
      allow create, delete: if false;
    }
    match /moderation_log/{id} {
      allow read: if isAdmin() || hasStaffRole(['Manager']);
      allow write: if false;
    }
    match /moderation_removed/{id} {
      allow read: if isAdmin() || hasStaffRole(['Manager']);
      allow write: if false;
    }
    match /settings/moderation {
      allow read: if signedIn();
      allow write: if isAdmin() || hasStaffRole(['Manager']);
    }

    // ── Reviews (vets & products) ─────────────────────────────────────────
    function reviewAuthor(d) {
      return d.get('reviewerId', d.get('userId', ''));
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && notSuspended()
        && reviewAuthor(request.resource.data) == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && optShortString('comment', 2000) && optShortString('text', 2000);
      allow update: if isAdmin()
        || (signedIn() && reviewAuthor(resource.data) == request.auth.uid
            && reviewAuthor(request.resource.data) == request.auth.uid
            && request.resource.data.rating >= 1 && request.resource.data.rating <= 5);
      allow delete: if isAdmin() || (signedIn() && reviewAuthor(resource.data) == request.auth.uid);
    }

    // ── Notifications ──────────────────────────────────────────────────────
    match /notifications/{userId} {
      allow read, delete: if isSelf(userId) || isAdmin();

      match /items/{itemId} {
        allow read, delete: if isSelf(userId) || isAdmin();
        // The owner only flips read flags.
        allow update: if isAdmin()
          || (isSelf(userId) && changed().hasOnly(['read', 'isRead', 'readAt']));
        // Others may notify a user (likes, comments, orders), within sane bounds.
        allow create: if signedIn() && notSuspended()
          && request.resource.data.keys().hasOnly(['title', 'body', 'message', 'category', 'type', 'url',
                                                   'read', 'isRead', 'timestamp', 'createdAt', 'id', 'fromUserId'])
          && shortString(request.resource.data.title, 100)
          && optShortString('body', 500) && optShortString('message', 500)
          && optShortString('category', 30) && optShortString('type', 30)
          && isSafeLink(request.resource.data.get('url', null))
          && request.resource.data.get('fromUserId', request.auth.uid) == request.auth.uid
          && request.resource.data.get('read', false) == false
          && request.resource.data.get('isRead', false) == false;
      }
    }

    // ── IoT ────────────────────────────────────────────────────────────────
    // LoRa gateways: written only by lora_ingest (admin SDK); admins monitor.
    match /gateways/{gatewayId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // OTA release pointers (firmware/esp32dev, firmware/lora-gateway).
    match /firmware/{target} {
      allow read, write: if isAdmin();
    }

    // Collars are created by the ingest functions and linked to an owner by an
    // admin (ownerId). Owners control tracking; telemetry is server-written.
    function deviceOwner(d) {
      return d.get('ownerId', d.get('userId', ''));
    }
    match /devices/{deviceId} {
      allow read: if (signedIn() && deviceOwner(resource.data) == request.auth.uid) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && deviceOwner(resource.data) == request.auth.uid
            && changed().hasOnly(['name', 'petId', 'petName', 'trackingMode', 'lostMode',
                                  'ringRequestedAt', 'safeZone', 'safeZoneLat', 'safeZoneLng',
                                  'safeZoneRadiusM', 'alertsEnabled', 'updatedAt'])
            && (unchanged('petId') || request.resource.data.petId == null
                || isPetOwner(request.resource.data.petId)));

      match /history/{point} {
        allow read: if isAdmin()
          || (signedIn() && deviceOwner(get(/databases/$(database)/documents/devices/$(deviceId)).data) == request.auth.uid);
        allow write: if false;
      }
    }

    // ── Content ────────────────────────────────────────────────────────────
    // Articles. Only approved ones are public: readers (website and app) must query with isApproved == true, authors
    // can also list their own posts (authorId == uid), admins everything. That query needs the composite index
    // isApproved + timestamp in firestore.indexes.json.
    match /blogs/{blogId} {
      function blogShape() {
        let d = request.resource.data;
        return shortString(d.get('title', ''), 200) && d.get('title', '') != ''
          && shortString(d.get('content', ''), 100000)
          && shortString(d.get('category', ''), 40)
          && optShortString('authorName', 80)
          && (!('tags' in d) || (d.tags is list && d.tags.size() <= 12))
          && (!('imageUrl' in d) || d.imageUrl == null || d.imageUrl == ''
              || (d.imageUrl is string && d.imageUrl.size() <= 600 && d.imageUrl.matches('https://.*')));
      }

      allow read: if resource.data.isApproved == true
        || isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn() && notSuspended() && blogShape()
        && (isAdmin() || (request.resource.data.authorId == request.auth.uid
            && request.resource.data.get('isApproved', false) == false
            && request.resource.data.get('status', 'PENDING').lower() in ['pending', 'draft']));
      // An author may fix a post that is still in review. Once it is live only an admin can change it, otherwise an
      // approved article could be rewritten without anyone looking at it again.
      allow update: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid
            && resource.data.isApproved == false
            && unchanged('authorId') && unchanged('isApproved') && unchanged('status')
            && blogShape());
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /coupons/{couponCode} {
      allow read: if true;
      // usageCount is counted by the create_order function; nobody else may touch it.
      allow write: if isAdmin() || hasStaffRole(['Manager']);
    }

    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global settings (banner, maintenance mode, AI switch, shipping fee …).
    match /settings/{settingId} {
      allow read: if true;
      // The announcement bar (settings/announcement) is also editable by managers, like the ERP settings.
      allow write: if isAdmin() || (settingId in ['erp', 'announcement'] && hasStaffRole(['Manager']));
    }

    // Admin broadcast history (sending itself goes through send_broadcast).
    match /broadcasts/{id} {
      allow read, write: if isAdmin();
    }

    // Newsletter sign-ups: anyone may add their own address; only admins read.
    match /newsletter/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['email', 'source', 'subscribedAt', 'createdAt'])
        && shortString(request.resource.data.email, 254)
        && request.resource.data.email.matches('[^@\\s]+@[^@\\s]+\\.[^@\\s]+')
        && optShortString('source', 40);
    }

    // Per-user request counters for rate-limited callables (functions only).
    match /rate_limits/{id} {
      allow read, write: if false;
    }

    // ── ERP / POS ──────────────────────────────────────────────────────────
    match /pos_sales/{id} {
      allow read, create: if isStaff();
      allow update: if isStaff();          // refunds
      allow delete: if false;              // receipts are never deleted
    }
    match /pos_shifts/{id} {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }
    match /inventoryMovements/{id} {
      allow read: if isStaff() || isAdmin();
      allow write: if false;              // append-only via server Cloud Functions
    }
    match /stock_moves/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;      // append-only ledger
    }
    match /counters/{id} {
      allow read, write: if isStaff();
    }
    match /suppliers/{id} {
      allow read, write: if hasStaffRole(['Manager', 'Accountant', 'Storekeeper', 'Pharmacist']);
    }
    match /purchase_orders/{id} {
      allow read, write: if hasStaffRole(['Manager', 'Accountant', 'Storekeeper', 'Pharmacist']);
    }
    match /supplier_payments/{id} {
      allow read, create: if hasStaffRole(['Manager', 'Accountant']);
      allow update, delete: if isAdmin();
    }
    match /expenses/{id} {
      allow read, write: if hasStaffRole(['Manager', 'Accountant']);
    }
    match /staff/{id} {
      allow read: if isStaff();
      allow write: if hasStaffRole(['Manager']);
    }
    match /attendance/{id} {
      allow read, write: if isStaff();
    }
    match /payroll/{id} {
      allow read: if hasStaffRole(['Manager', 'Accountant']);
      allow create: if hasStaffRole(['Manager', 'Accountant']);
      allow update, delete: if false;
    }
  }
}
