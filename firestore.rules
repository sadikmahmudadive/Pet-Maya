rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document by ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check for Admin role
    function isAdmin() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isAuthenticated() && (role == 'Admin' || role == 'admin' || role == 'superAdmin' || role == 'Super Admin');
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Pets
    match /pets/{petId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Calendar & Reminders
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Shop Catalog & Inventory
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Veterinarians & Clinics
    match /vets/{vetId} {
      allow read: if true;
      allow write: if true;
    }

    // Veterinary Service Records
    match /service_records/{recordId} {
      allow read, write: if true;
    }

    // Community Posts & Comments
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if true;
      // Allow updates for likes, unlikes, commentsCount, sharesCount, and comments array
      allow update: if true;
      // Only post author or admin can delete post
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      match /comments/{commentId} {
        allow read, create, update: if true;
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Reviews & Ratings
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{userId} {
      match /items/{itemId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        // Others may notify a user (likes, comments, orders), within sane bounds
        allow create: if isAuthenticated()
          && request.resource.data.keys().hasOnly(['title', 'body', 'message', 'category', 'type', 'url', 'read', 'isRead', 'timestamp', 'createdAt', 'id'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 100
          && (!('body' in request.resource.data) || request.resource.data.body.size() <= 500);
      }
    }

    // Tele-vet video calls: WebRTC signaling (offer/answer/ICE) between two parties
    function isCallParty(call) {
      return isAuthenticated() && (call.callerId == request.auth.uid || call.calleeId == request.auth.uid);
    }
    match /calls/{callId} {
      allow read: if isCallParty(resource.data);
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['callerId', 'calleeId', 'callerName', 'calleeName', 'callerPhoto', 'petId', 'petName', 'appointmentId', 'status', 'createdAt', 'createdAtMs', 'offer', 'participants', 'video'])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.participants == [request.auth.uid, request.resource.data.calleeId];
      allow update: if isCallParty(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer', 'answeredAt', 'endedAt', 'endedBy', 'endReason'])
        && (
          (resource.data.calleeId == request.auth.uid && resource.data.status == 'ringing' && request.resource.data.status in ['accepted', 'declined'])
          || (resource.data.callerId == request.auth.uid && resource.data.status == 'ringing' && request.resource.data.status in ['cancelled', 'missed'])
          || (resource.data.status == 'accepted' && request.resource.data.status == 'ended')
        );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if isCallParty(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if isAuthenticated() && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if isCallParty(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if isAuthenticated() && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
      }
    }

    // Devices & Smart Trackers
    // LoRa gateways: written only by lora_ingest (admin SDK); visible to admins for monitoring.
    match /gateways/{gatewayId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // OTA release pointers (firmware/esp32dev, firmware/lora-gateway): admin-managed.
    match /firmware/{target} {
      allow read, write: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // Blogs
    match /blogs/{blogId} {
      allow read, write: if true;
    }

    // Coupons
    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if isAdmin() || true; // Currently allowing for testing, should ideally be isAdmin()
    }

    // Promos
    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Currently allowing for testing
    }

    // Global App Settings (global, globalBanner, etc.)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }
  }
}
