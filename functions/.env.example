# Server-side tracking (copy to functions/.env, deployed with `firebase deploy --only functions`).
# Secrets are NOT stored here:  firebase functions:secrets:set GA4_API_SECRET
#                               firebase functions:secrets:set META_CAPI_TOKEN
GA4_MEASUREMENT_ID=G-WSN2ZQE4PF
# Setting META_PIXEL_ID turns Meta CAPI on and then `firebase functions:secrets:set META_CAPI_TOKEN` is required to deploy.
# Leave it empty until you have the token; Meta is then skipped.
META_PIXEL_ID=1423036852741048
# Events the server sends to GA4 (the browser's GTM tag sends the rest). "*" = all, but then turn the GTM GA4
# event tags off or you will count everything twice.
GA4_SERVER_EVENTS=purchase
# Paste the "Test events" code from Meta Events Manager while testing; remove for production.
META_TEST_EVENT_CODE=
# GTM *server* container URL (same as the web app's VITE_SGTM_URL). When set, order purchases and /collect events are
# handed to it and its tags (GA4, Meta CAPI…) forward them. META_PIXEL_ID / META_CAPI_TOKEN are then not needed here.
SGTM_URL=

# Public site origin used for product feed links (/feeds/*.xml). Set it here to skip the deploy prompt.
SITE_URL=https://www.petmaya.app
