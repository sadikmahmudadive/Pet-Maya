# ══════════════════════════════════════════════════════════════════════════════
# SECRETS & CREDENTIALS
# ══════════════════════════════════════════════════════════════════════════════
.env
.env.*
!.env.example

# Android signing
*.keystore
*.jks
*.p12
*.pfx
*.pem
android/key.properties
android/local.properties

# Firebase app config (downloaded from console, not committed)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist


# ══════════════════════════════════════════════════════════════════════════════
# FLUTTER & DART
# ══════════════════════════════════════════════════════════════════════════════
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Generated code
lib/generated/
*.freezed.dart
*.g.dart

# Flutter metadata (machine-generated, not useful to teammates)
.metadata


# ══════════════════════════════════════════════════════════════════════════════
# ANDROID
# ══════════════════════════════════════════════════════════════════════════════
.gradle/
Captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
android/*/build/
*.apk
*.aab
*.aar
*.hprof
android/*.hprof


# ══════════════════════════════════════════════════════════════════════════════
# iOS & macOS
# ══════════════════════════════════════════════════════════════════════════════
*.xcworkspace
xcuserdata/
DerivedData/
*.moved-aside
*.xcuserstate
ios/Pods/
ios/.res/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets.zip
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/ServiceDefinitions.json
macos/Pods/
macos/Flutter/ephemeral/


# ══════════════════════════════════════════════════════════════════════════════
# WINDOWS & LINUX DESKTOP
# ══════════════════════════════════════════════════════════════════════════════
windows/flutter/ephemeral/
linux/flutter/ephemeral/


# ══════════════════════════════════════════════════════════════════════════════
# WEB
# ══════════════════════════════════════════════════════════════════════════════
# Keep web/ source files; only ignore generated build output
.web/

# Always keep Google Site Verification & well-known (needed for hosting)
!web/.well-known/
!web/.well-known/**


# ══════════════════════════════════════════════════════════════════════════════
# FIREBASE & CLOUD FUNCTIONS
# ══════════════════════════════════════════════════════════════════════════════
.firebase/
firebase-debug.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*
*-debug.log*

# Cloud Functions dependencies
functions/node_modules/
functions/lib/


# ══════════════════════════════════════════════════════════════════════════════
# NODE / NPM
# ══════════════════════════════════════════════════════════════════════════════
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js


# ══════════════════════════════════════════════════════════════════════════════
# AI AGENT & TOOL DIRECTORIES
# ══════════════════════════════════════════════════════════════════════════════
.agents/
.claude/
.gemini/
skills-lock.json


# ══════════════════════════════════════════════════════════════════════════════
# IDE & EDITORS
# ══════════════════════════════════════════════════════════════════════════════
.idea/
*.iml
*.ipr
*.iws
.vscode/
.history/
doc/api/


# ══════════════════════════════════════════════════════════════════════════════
# LOGS & TEMPORARY FILES
# ══════════════════════════════════════════════════════════════════════════════
*.log
*.tmp
*.bak
*.swp
*~


# ══════════════════════════════════════════════════════════════════════════════
