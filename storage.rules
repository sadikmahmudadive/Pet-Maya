rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Profiles folder
    match /profile_pics/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Pets folder
    match /pets/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Community folder
    match /community_posts/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Blogs & Cover images folder
    match /blogs/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    match /blog_covers/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Shop folder
    match /shop_products/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Global match fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }
  }
}
