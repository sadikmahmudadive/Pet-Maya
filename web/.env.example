
# Public Google Maps JS key. It ships to browsers: restrict it to your site's
# HTTP referrers and the Maps APIs in Google Cloud Console.
# VITE_GOOGLE_MAPS_API_KEY=

# reCAPTCHA Enterprise site key for Firebase App Check (Firebase console →
# App Check → Apps → Web). Once set and deployed, enforce App Check.
# VITE_APPCHECK_RECAPTCHA_KEY=

# Never put secrets (OpenAI, service accounts) in VITE_ variables: everything
# prefixed VITE_ is bundled into the public JavaScript.

# Google Tag Manager web container (GTM-XXXXXXX). Empty = no browser tags are loaded.
# VITE_GTM_ID=
# Your GTM *server* container URL (a first-party subdomain, e.g. https://sgtm.petmaya.app). When set, /collect is not
# used by the browser; the web container's Google tag must have server_container_url set to the same URL.
# VITE_SGTM_URL=
# Meta Pixel id (public). Loaded in the browser only after the visitor allows ads. Defaults to Pet Maya's pixel;
# set 0 to disable. Don't also add a Meta Pixel tag in GTM.
# VITE_META_PIXEL_ID=1423036852741048
# The browser also posts events to /collect (a Cloud Function that forwards to Meta CAPI / GA4).
# Default: on in production builds. Set 0 to turn off, 1 to turn on in dev.
# VITE_SERVER_TRACKING=
